pipeline {
    agent any
    stages {
        stage('global stage') {
            agent {
                docker {
                    image 'postman/newman:latest'
                    args '-u root --entrypoint='
                }
            }
            stages {
                    
                    stage('install deps') {
                    steps {
                        
                        sh 'npm install -g newman-reporter-allure'
                    }
                }
                stage('clean allure results') {
                    steps {
                        // nettoyage du dossier allure-results
                        sh '''
                            echo "suppression du cache allure..."
                            rm -rf output/allure-results
                            mkdir -p output/allure-results
                            echo "dossier nettoye avec succes"
                        '''
                    }
                }
        
                stage('run user test') {
                    steps {   
                        script {
                            // execution newman avec environnement et allure
                            sh 'npx newman run Postman_CICD.json -e environment.json --reporters cli,allure --reporter-allure-resultsDir output/allure-results'

                            stash name: 'allure-results', includes: 'output/allure-results/*'
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                
                unstash 'allure-results'
                archiveArtifacts 'output/allure-results/*'
                allure includeProperties: false,
                       jdk: '',
                       results: [[path: 'output/allure-results/']]
            }
        }
    }
}