pipeline {
    agent any

      stages{

        stage('global stage'){
            
            agent{
                docker{
                    image 'postman/newman:latest'
                    args '-u root --entrypoint='
                }
            }
            
            stages{
                stage('install allure'){
                    steps{
                        sh 'npm install --save-dev newman-reporter-allure'
                    }
                }

                stage('clean allure results'){
                    
                    steps{
                        sh '''
                            echo "Suppression du cache Allure..."
                            rm -rf allure-results
                            mkdir -p allure-results
                            echo "Dossier allure-results nettoyé avec succès"
                        '''
                    }
                }
        
                stage('run avec new man'){
                    steps {
                    
                        sh 'newman run Postman_CICD.json -e environment.json --reporters cli,allure --reporter-allure-resultsDir allure-results'
                    
                
                             }
                }
            }
        }
    }


post {
        always {
            node('built-in') {
                script {
                    try {
                        // nettoyage préalable des anciens résultats extraits
                        sh 'rm -rf output/allure-results allure-report'
                        
                        unstash 'allure-results'
                        archiveArtifacts 'output/allure-results/*'
                        
                        // force la génération d un nouveau rapport propre sans fusion d historique
                        allure includeProperties: false,
                               jdk: '',
                               reportBuildPolicy: 'ALWAYS',
                               results: [[path: 'output/allure-results/']]
                    } catch (Exception e) {
                        echo "aucun resultat allure a publier."
                    }
                }
            }
        }
    }
}